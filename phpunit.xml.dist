<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" colors="true" bootstrap="vendor/autoload.php" cacheDirectory="var/.phpunit.cache" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd">
    <testsuites>
        <testsuite name="Palmtree Collection">
            <directory>./tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
